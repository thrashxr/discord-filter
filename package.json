{
   "name": "discord-filter",
   "version": "2.0.0",
   "description": "Lightweight, dependency-free profanity / link / Discord-invite text filter with bypass detection. Framework-agnostic.",
   "type": "module",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
         },
         "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
         }
      },
      "./package.json": "./package.json"
   },
   "sideEffects": false,
   "files": [
      "dist",
      "README.md",
      "changelog.md",
      "LICENSE"
   ],
   "scripts": {
      "build": "tsup",
      "typecheck": "tsc --noEmit",
      "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\"",
      "test": "vitest run",
      "test:watch": "vitest",
      "bench": "vitest bench --run",
      "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
   },
   "keywords": [
      "filter",
      "profanity",
      "moderation",
      "badwords",
      "swear",
      "discord",
      "discordjs",
      "invite",
      "url-detection",
      "bypass",
      "leetspeak",
      "turkish",
      "chat"
   ],
   "author": "Thrasher",
   "license": "ISC",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/thrashxr/discord-filter.git"
   },
   "homepage": "https://github.com/thrashxr/discord-filter#readme",
   "bugs": {
      "url": "https://github.com/thrashxr/discord-filter/issues"
   },
   "engines": {
      "node": ">=18"
   },
   "devDependencies": {
      "@types/node": "^22.10.2",
      "@typescript-eslint/eslint-plugin": "^8.18.0",
      "@typescript-eslint/parser": "^8.18.0",
      "eslint": "^8.57.1",
      "tsup": "^8.3.5",
      "typescript": "^5.7.2",
      "vitest": "^3.2.6"
   }
}
